@model Subject
<div class="container-fluid px-4 py-4">
    <form class="px-3" asp-action="Edit" asp-controller="Subjects" asp-area="Admin" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Name" class="form-label font-weight-bold">Title</label>
                    <input asp-for="Name" type="text" class="form-control border px-2" placeholder="Subject title">
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>
        </div>
        <h6 class="mt-2">Book details</h6>
        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="BookName" class="form-label font-weight-bold">Book</label>
                    <input asp-for="BookName" type="text" class="form-control border px-2" placeholder="Book title">
                    <span asp-validation-for="BookName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Author" class="form-label font-weight-bold">Author</label>
                    <input asp-for="Author" type="text" class="form-control border px-2" placeholder="Author name">
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="PublicationYear" class="form-label font-weight-bold">Publication date</label>
                    <input asp-for="PublicationYear" placeholder="Publication year" type="number" class="form-control border px-2">
                    <span asp-validation-for="PublicationYear" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label class="form-label font-weight-bold">Edition</label>
                    <input type="text" class="form-control border px-2" placeholder="Book edition">
                    <span class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Subjects" asp-controller="Home" asp-area="Admin" type="button" class="btn btn-outline-secondary">Back</a>
            <button type="submit" class="btn btn-outline-primary">Save</button>
        </div>
    </form>
</div>