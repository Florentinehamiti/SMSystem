@model DiaryViewModel

<div class="container-fluid px-4 py-4">
    <form class="px-3" asp-action="Edit" asp-controller="Diary" asp-area="Admin" enctype="multipart/form-data">
       <input asp-for="Id" type="hidden" />
        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="SchoolCode" class="form-label font-weight-bold">School Code</label>
                    <input asp-for="SchoolCode" placeholder="School Code" type="number" class="form-control border px-2" />
                    <span asp-validation-for="SchoolCode" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Year" class="form-label font-weight-bold">Year of studies</label>
                    <input asp-for="Year" placeholder="Year of studies" type="number" class="form-control border px-2" />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Paralel" class="form-label font-weight-bold">Paralel</label>
                    <input asp-for="Paralel" placeholder="Paralel" type="number" class="form-control border px-2" />
                    <span asp-validation-for="Paralel" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="TeacherId" class="form-label font-weight-bold">Teacher</label>
                    <select asp-for="TeacherId" asp-items="@(new SelectList(Model.Teachers, "Id", "Name"))" class="form-control border px-2">
                        <option value="">Select Teacher</option>
                    </select>
                    <span asp-validation-for="TeacherId" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" asp-controller="Diary" asp-area="Admin" type="button" class="btn btn-outline-secondary">Back</a>
            <button type="submit" class="btn btn-outline-primary">Save</button>
        </div>
    </form>
</div>