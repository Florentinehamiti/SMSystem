@model TeacherViewModel
@using Microsoft.Extensions.Localization
@using Presentation
@inject IStringLocalizer<SharedResource> Localizer

<div class="container-fluid px-4 py-4">
    <form class="px-3" asp-action="Edit" asp-controller="Teacher" asp-area="Admin" enctype="multipart/form-data">

        <input type="hidden" asp-for="Id" />

      
        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Name" class="form-label font-weight-bold">@Localizer["Name"]</label>
                    <input asp-for="Name" placeholder="Name" type="text" class="form-control border px-2" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Surname" class="form-label font-weight-bold">@Localizer["Lastname"]</label>
                    <input asp-for="Surname" placeholder="Surname" type="text" class="form-control border px-2" />
                </div>
            </div>
        </div>

 
        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Email" class="form-label font-weight-bold">@Localizer["Email"]</label>
                    <input asp-for="Email" placeholder="Email" type="text" class="form-control border px-2" />
                </div>
            </div>
            <div class="col-md-6 d-flex align-items-center">
                <div class="form-check form-switch d-flex align-items-center">
                    <input class="form-check-input" asp-for="Qualified" type="checkbox" id="flexSwitchCheckDefault" />
                    <label class="form-check-label mx-3 mb-0" for="Qualified">@Localizer["Qualified"]</label>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label class="font-weight-bold">@Localizer["ProfilePic"]</label>
                    <input asp-for="ProfilePhoto" type="file" class="form-control" />
                    @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
                    {
                        <img src="~/Images/@Model.ProfilePhotoPath" alt="Profile Photo" class="mt-3 profile-pic" />
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Birthday" class="form-label font-weight-bold">@Localizer["Birthday"]</label>
                    <input asp-for="Birthday" type="date" class="form-control border px-2" />
                </div>
            </div>
        </div>

  
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" asp-controller="Teacher" asp-area="Admin" type="button" class="btn btn-outline-secondary">@Localizer["Back"]</a>
            <button type="submit" class="btn btn-outline-primary">@Localizer["Save"]</button>
        </div>
    </form>
</div>
