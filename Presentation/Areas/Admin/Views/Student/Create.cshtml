@model StudentViewModel
@using Microsoft.Extensions.Localization
@using Presentation
@inject IStringLocalizer<SharedResource> Localizer

<div class="container-fluid px-4 py-4">
    <form class="px-3" asp-action="Create" asp-controller="Student" asp-area="Admin" enctype="multipart/form-data">



        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Name" class="form-label font-weight-bold">@Localizer["Name"]</label>
                    <input asp-for="Name" placeholder="Name" type="text" class="form-control border px-2" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="ParentName" class="form-label font-weight-bold">@Localizer["ParentName"]</label>
                    <input asp-for="ParentName" placeholder="Parent name" type="text" class="form-control border px-2" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Lastname" class="form-label font-weight-bold">@Localizer["Lastname"]</label>
                    <input asp-for="Lastname" placeholder="Surname" type="text" class="form-control border px-2" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Tel" class="form-label font-weight-bold">@Localizer["Telephone"]</label>
                    <input asp-for="Tel" placeholder="Telephone" type="text" class="form-control border px-2" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Email" class="form-label font-weight-bold">@Localizer["Email"]</label>
                    <input asp-for="Email" placeholder="Email" type="text" class="form-control border px-2" />
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-check-label font-weight-bold">@Localizer["Gender"]</label>

                <div class="d-flex align-items-center">
                    <div class="form-check p-1">
                        <input class="form-check-input" type="radio" asp-for="Gender" value="true" id="genderMale" />
                        <label class="form-check-label" for="genderMale">@Localizer["Male"]</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Gender" value="false" id="genderFemale" />
                        <label class="form-check-label" for="genderFemale">@Localizer["Female"]</label>
                    </div>
                </div>

            </div>
        </div>


        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label class="font-weight-bold">@Localizer["ProfilePic"]</label>
                    <input asp-for="ProfilePhoto" type="file" class="form-control border px-2" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Birthday" class="form-label font-weight-bold">@Localizer["Birthday"]</label>
                    <input asp-for="Birthday" type="date" class="form-control border px-2" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="DiaryId" class="form-label font-weight-bold">@Localizer["Teacher"]</label>
                    <select asp-for="DiaryId" asp-items="@(new SelectList(Model.Diaries.Select(d => new { d.Id, Naming = d.Teacher.Name + " " + d.Teacher.Surname + " - " + d.Class.ClassNumber + " / " + d.Paralel }), "Id", "Naming"))" class="form-control border px-2">
                        <option value="">@Localizer["SelectDiary"]</option>
                    </select>
                    <span asp-validation-for="DiaryId" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" asp-controller="Student" asp-area="Admin" type="button" class="btn btn-outline-secondary">@Localizer["Back"]</a>
            <button type="submit" class="btn btn-outline-primary">@Localizer["Save"]</button>
        </div>
    </form>
</div>