@model StudentViewModel


<div class="container-fluid px-4 py-4">
    <form class="px-3" asp-action="Edit" asp-controller="Student" asp-area="Admin" enctype="multipart/form-data">

        <input type="hidden" asp-for="Id" />


        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Name" class="form-label font-weight-bold">Name</label>
                    <input asp-for="Name" placeholder="Name" type="text" class="form-control border px-2" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="ParentName" class="form-label font-weight-bold">Parent name</label>
                    <input asp-for="ParentName" placeholder="Parent name" type="text" class="form-control border px-2" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Lastname" class="form-label font-weight-bold">Surname</label>
                    <input asp-for="Lastname" placeholder="Surname" type="text" class="form-control border px-2" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Tel" class="form-label font-weight-bold">Telephone</label>
                    <input asp-for="Tel" placeholder="Telephone" type="text" class="form-control border px-2" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Email" class="form-label font-weight-bold">Email</label>
                    <input asp-for="Email" placeholder="Email" type="text" class="form-control border px-2" />
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-check-label font-weight-bold">Gender</label>

                <div class="d-flex align-items-center">
                    <div class="form-check p-1">
                        <input class="form-check-input" type="radio" asp-for="Gender" value="true" id="genderMale" />
                        <label class="form-check-label" for="genderMale">Male</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Gender" value="false" id="genderFemale" />
                        <label class="form-check-label" for="genderFemale">Female</label>
                    </div>
                </div>

            </div>
        </div>


        <div class="row">
            <div class="col-md-6">
                <div class="input-container">
                    <label class="font-weight-bold">Profile Picture</label>
                    <input asp-for="ProfilePhoto" type="file" class="form-control border px-2" />
                    @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
                    {
                        <img src="~/Images/@Model.ProfilePhotoPath" alt="Profile Photo" class="mt-3 profile-pic" />
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="input-container">
                    <label asp-for="Birthday" class="form-label font-weight-bold">Birthday</label>
                    <input asp-for="Birthday" type="date" class="form-control border px-2" />
                </div>
            </div>
        </div>


        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" asp-controller="Student" asp-area="Admin" type="button" class="btn btn-outline-secondary">Back</a>
            <button type="submit" class="btn btn-outline-primary">Save</button>
        </div>
    </form>
</div>