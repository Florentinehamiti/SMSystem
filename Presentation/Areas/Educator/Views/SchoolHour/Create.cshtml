@model SchoolHourViewModel
@using Microsoft.Extensions.Localization
@using Presentation
@inject IStringLocalizer<SharedResource> Localizer

	<div class="container-fluid px-4 py-4">
		<form class="px-3" asp-action="Create" asp-controller="SchoolHour" asp-area="Educator">

			<input type="hidden" asp-for="DiaryId" />
			<input type="hidden" asp-for="TeacherId" />

			<div class="row">
				<div class="col-md-6">
					<div class="input-container">
					<label asp-for="HourNumber" class="form-label font-weight-bold">@Localizer["NumriOres"]</label>
						<input asp-for="HourNumber" placeholder="Numri i ores" type="number" class="form-control border px-2" value="@(Model.HourNumber > 0 ? Model.HourNumber.ToString() : "")" />
						<span asp-validation-for="HourNumber" class="text-danger"></span>
					</div>
					<div class="input-container mt-2">
					<label asp-for="Date" class="form-label font-weight-bold">@Localizer["TimeSchoolHour"]</label>
						<input asp-for="Date" placeholder="Paralel" type="datetime" readonly class="form-control border px-2" value="@DateTime.Now.ToString("yyyy-MM-dd HH:mm")" />
						<span asp-validation-for="Date" class="text-danger"></span>
					</div>
					<div class="input-container mt-2">
					<label asp-for="SubjectId" class="form-label font-weight-bold">@Localizer["Subject"]</label>
						<select asp-for="SubjectId" asp-items="@(new SelectList(Model.Subjects.Select(t => new { t.Id, FullName = t.Name }), "Id", "FullName"))" class="form-control border px-2">
						<option value="">@Localizer["SelectSubject"]</option>
						</select>
						<span asp-validation-for="SubjectId" class="text-danger"></span>
					</div>
					<div class="input-container mt-2">
					<label asp-for="SchoolHourDescribe" class="form-label font-weight-bold">@Localizer["School hour description"]</label>
						<textarea asp-for="SchoolHourDescribe" placeholder="Shkruaj përshkrimin e orës mësimore..." class="form-control border px-2" rows="4"></textarea>
						<span asp-validation-for="SchoolHourDescribe" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
					<label class="form-label font-weight-bold">@Localizer["PresentStudents"]</label>
					@foreach (var student in Model.Students)
					{
						<div class="form-check px-0">
							<input type="hidden" name="Students[@Model.Students.IndexOf(student)].StudentId" value="@student.StudentId" />
							<input type="hidden" name="Students[@Model.Students.IndexOf(student)].Name" value="@student.Name" />
							<input type="hidden" name="Students[@Model.Students.IndexOf(student)].Lastname" value="@student.Lastname" />
							<input type="checkbox" name="PresentStudentIds" value="@student.StudentId" class="form-check-input" id="student_@student.StudentId">
							<label class="form-check-label" for="student_@student.StudentId">@student.Name @student.Lastname</label>
						</div>
					}
						@* @foreach (var student in Model.Students)
						{
							<div class="form-check px-0">
								<input type="checkbox" name="PresentStudentIds" value="@student.StudentId" class="form-check-input" id="student_@student.StudentId">
								<label class="form-check-label" for="student_@student.StudentId">@student.Name @student.Lastname</label>
							</div>
						} *@
					</div>
				</div>
			</div>
			<div class="d-flex justify-content-end gap-2">
			<a asp-action="Index" asp-controller="SchoolHour" asp-area="Educator" type="button" class="btn btn-outline-secondary">@Localizer["Back"]</a>
			<button type="submit" class="btn btn-outline-primary">@Localizer["Save"]</button>
			</div>
		</form>
	</div>