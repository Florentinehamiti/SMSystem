@model DashboardTeacherViewModel;
@{
    ViewData["Title"] = "Home Page";
}
@using Microsoft.Extensions.Localization
@using Presentation
@inject IStringLocalizer<SharedResource> Localizer

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-lg-12 col-md-6 mb-md-0 mb-4">
            <div class="card">
                <div class="card-header pb-0">
                    <div class="row">
                        <div class="col-lg-6 col-7">
                            <h6>Klasa e 1/5</h6>
                            <p class="text-sm mb-0">
                                <span class="font-weight-bold">@Localizer["EvaluateStudent"] </span>
                            </p>
                        </div>
                        <div class="col-lg-6 col-5 my-auto text-end">
                            <div class="dropdown float-lg-end pe-4">
                                <a class="cursor-pointer" id="dropdownTable" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa fa-ellipsis-v text-secondary"></i>
                                </a>
                                <ul class="dropdown-menu px-2 py-3 ms-sm-n4 ms-n5" aria-labelledby="dropdownTable">
                                    <li><a class="dropdown-item border-radius-md" href="javascript:;">Action</a></li>
                                    <li><a class="dropdown-item border-radius-md" href="javascript:;">Another action</a></li>
                                    <li><a class="dropdown-item border-radius-md" href="javascript:;">Something else here</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body px-0 pb-2">
                    <div class="table-responsive">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">@Localizer["Subject"]</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">@Localizer["Top4Students"]</th>
                                    <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">@Localizer["AbsencesNr"]</th>
                                </tr>
                            </thead>
                            <tbody>
                               
                                    @foreach(var subject in Model.Subjects)
                                    {
                                    <tr>
                                        <td>
                                            <div class="d-flex px-2 py-1">
                                              
                                                <div class="d-flex flex-column justify-content-center">
                                                    <a asp-action="Index" asp-area="Educator" asp-controller="Subject" asp-route-diaryId="@Model.DiaryId" asp-route-subjectId="@subject.Id">
                                                        <h6 class="mb-0 text-sm">@subject.Name</h6>
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="avatar-group mt-2">
                                                @if (Model.SubjectStudents.ContainsKey(subject.Id))
                                                {
                                                    @foreach (var student in Model.SubjectStudents[subject.Id])
                                                    {
                                                        <a href="javascript:;" class="avatar avatar-xs rounded-circle" data-bs-toggle="tooltip" data-bs-placement="bottom" title="@student.Name">
                                                            <img src="@Url.Content("~/Images/" + @student.ProfilePhotoPath)" alt="@student.Name">
                                                        </a>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-xs text-muted">Asnjë nxënës</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            @if (Model.SubjectAbsences.ContainsKey(subject.Id))
                                            {
                                                @Model.SubjectAbsences[subject.Id]
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </td>
                                      
                                    </tr>
                                    }
                             
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!--   Core JS Files   -->
<script src="~/theme/js/core/popper.min.js"></script>
<script src="~/theme/js/core/bootstrap.min.js"></script>
<script src="~/theme/js/plugins/perfect-scrollbar.min.js"></script>
<script src="~/theme/js/plugins/smooth-scrollbar.min.js"></script>
<script src="~/theme/js/plugins/chartjs.min.js"></script>
