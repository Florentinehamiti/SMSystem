@model StudentDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="container-fluid px-4 py-4">
    <div class="row">
        <div class="col-md-6">
            <label class="font-weight-bold">Profile Picture</label>
            @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
            {
                <img src="@Url.Content("~/Images/" + Model.ProfilePhotoPath)" alt="Profile Photo" class="mt-3 profile-pic" />
            }
            else
            {
                <p class="text-warning">No profile photo available.</p>
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label font-weight-bold">Name</label>
            <div class="form-control px-2">@Model.FullName</div>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label font-weight-bold">Parent name</label>
            <div class="form-control px-2">@Model.ParentName</div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label font-weight-bold">Email</label>
            <div class="form-control px-2">@Model.Email</div>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label font-weight-bold">Telephone</label>
            <div class="form-control px-2">@Model.Tel</div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label font-weight-bold">Birthday</label>
            <div class="form-control px-2">@Model.Birthday</div>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label font-weight-bold">Gender</label>
            <div class="form-control px-2">
                @(Model.Gender ? "Male" : "Female")
            </div>
        </div>
    </div>

   

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" asp-controller="Evaluate" asp-area="Educator" class="btn btn-outline-secondary">
            Back
        </a>
    </div>

</div>
