@model StudentDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="container-fluid px-4 py-4">
    <div class="row">
        <div class="col-md-3">
            @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
            {
                <img src="@Url.Content("~/Images/" + Model.ProfilePhotoPath)" alt="Profile Photo" class="mt-3 profile-pic w-80" />
            }
            else
            {
                <p class="text-warning">No profile photo available.</p>
            }
        </div>
        <div class="col-md-3 mb-3 mt-3">
            <label class="form-label font-weight-bold mx-0">Name</label>
            <div class="form-control mb-2">@Model.FullName</div>
            <label class="form-label mx-0 font-weight-bold">Parent name</label>
            <div class="form-control mb-2">@Model.ParentName</div>
            <label class="form-label mx-0 font-weight-bold">Email</label>
            <div class="form-control mb-2">@Model.Email</div>
        </div>
        <div class="col-md-3 mb-3 mt-3">
            <label class="form-label font-weight-bold mx-0">Telephone</label>
            <div class="form-control mb-2">@Model.Tel</div>
            <label class="form-label font-weight-bold mx-0">Birthday</label>
            <div class="form-control mb-2">@Model.Birthday.ToString("MM/dd/yyyy")</div>
            <label class="form-label font-weight-bold mx-0">Gender</label>
            <div class="form-control mb-2">
                @(Model.Gender ? "Male" : "Female")
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-12">
            <div class="card my-4">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3">
                        <h6 class="text-white text-capitalize ps-3">Evaluations</h6>
                    </div>
                </div>
                <div class="card-body px-0 pb-2">
                    <div class="table-responsive p-0">
                        <div class="d-flex justify-content-between align-items-center mt-1 mx-4">
                            <h6>@Model.FullName evaluations</h6>
                        </div>
                        <table class="table align-items-center mb-0 w-auto">

                            <thead>
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 w-3">#</th>

                                  
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Lenda</th>
                                 
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">Nota</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var counter = 1;
                                }
                                @foreach (var student in Model.Evaluations)
                                {
                                    <tr>
                                        <td class="text-xs font-weight-bold text-center m-3">@counter</td>
                                        <td class="">
                                            <p class="text-xs text-secondary font-weight-bold mb-0 text-center">@student.SubjectName</p>
                                        </td>
                                        <td class="">
                                            <p class="text-xs text-secondary font-weight-bold mb-0 text-center">@student.Grade</p>
                                        </td>
                                    </tr>
                                    counter++;
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>



    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" asp-controller="Evaluate" asp-area="Educator" class="btn btn-outline-secondary">
            Back
        </a>
    </div>

</div>
