@model RemarkViewModel
@using Microsoft.Extensions.Localization
@using Presentation
@inject IStringLocalizer<SharedResource> Localizer

<div class="container-fluid px-4 py-4">
    <div class="row">
        <div class="col-md-3">
            @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath))
            {
                <img src="@Url.Content("~/Images/" + Model.ProfilePhotoPath)" alt="Profile Photo" class="mt-3 profile-pic w-80" />
            }
            else
            {
                <p class="text-warning">@Localizer["Nuk ka foto"]</p>
            }
        </div>
        <div class="col-md-3 mb-3 mt-3">
            <label class="form-label font-weight-bold mx-0">@Localizer["Name"]</label>
            <div class="form-control mb-2">@Model.FullName</div>
            <label class="form-label mx-0 font-weight-bold">@Localizer["ParentName"]</label>
            <div class="form-control mb-2">@Model.ParentName</div>
            <label class="form-label mx-0 font-weight-bold">@Localizer["Email"]</label>
            <div class="form-control mb-2">@Model.Email</div>
        </div>
        <div class="col-md-3 mb-3 mt-3">
            <label class="form-label font-weight-bold mx-0">@Localizer["Telephone"]</label>
            <div class="form-control mb-2">@Model.Tel</div>
            <label class="form-label font-weight-bold mx-0">@Localizer["Birthday"]</label>
            <div class="form-control mb-2">
                @Model.Birthday?.ToString("MM/dd/yyyy")
            </div>
            <label class="form-label font-weight-bold mx-0">@Localizer["Gender"]</label>
            <div class="form-control mb-2">
                @(Model.Gender.HasValue ? (Model.Gender.Value ? "Male" : "Female") : "Not specified")
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card my-4">
                <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                    <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3">
                        <h6 class="text-white text-capitalize ps-3">@Localizer["Remarks"]</h6>
                    </div>
                </div>
                <div class="card-body px-0 pb-2">
                    <div class="table-responsive p-0">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">@Localizer["Date"]</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">@Localizer["Hour"]</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">@Localizer["Subject"]</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 text-center">@Localizer["Description"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Remarks != null && Model.Remarks.Any())
                                {
                                    foreach (var remark in Model.Remarks)
                                    {
                                        <tr>
                                            <td class="">
                                                <p class="text-xs text-secondary font-weight-bold mb-0 text-center">@remark.Date.ToString("MM/dd/yyyy")</p>
                                            </td>
                                            <td class="">
                                                <p class="text-xs text-secondary font-weight-bold mb-0 text-center">@remark.HourNumber</p>
                                            </td>
                                            <td class="">
                                                <p class="text-xs text-secondary font-weight-bold mb-0 text-center">@remark.SubjectName</p>
                                            </td>
                                            <td class="">
                                                <p class="text-xs text-secondary font-weight-bold mb-0 text-center">@remark.Description</p>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-warning">No remarks available.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>